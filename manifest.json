{
  "manifest_version": 3,
  "name": "Paper Noter",
  "description": "只理解当前视野的学术 PDF 阅读器，保存每篇论文的重点、名词和图片解释。",
  "version": "0.7.0",
  "key": "",
  "action": {
    "default_title": "Paper Noter"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": ["storage", "webNavigation", "webRequest"],
  "host_permissions": ["https://*/*", "http://*/*", "file:///*"]
}
